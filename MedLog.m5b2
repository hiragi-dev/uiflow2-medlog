{"category":"MedLog","color":"#0fb1d2","uiflow2":{"jscode":"const CUSTOM_MEDLOG_LANGUAGES = {\n  \"CUSTOM_MEDLOG_INIT\": {\n    \"en\": \"%1 init, フォルダ: %2\"\n  },\n  \"CUSTOM_MEDLOG__PATH\": {\n    \"en\": \" %1 _path, year: %2, month: %3\"\n  },\n  \"CUSTOM_MEDLOG__LOAD\": {\n    \"en\": \" %1 _load, year: %2, month: %3\"\n  },\n  \"CUSTOM_MEDLOG__SAVE\": {\n    \"en\": \" %1 _save, year: %2, month: %3, data: %4\"\n  },\n  \"CUSTOM_MEDLOG__DAYS_IN_MONTH\": {\n    \"en\": \" %1 _days_in_month, year: %2, month: %3\"\n  },\n  \"CUSTOM_MEDLOG_書きこむ\": {\n    \"en\": \" %1 書きこむ, 年: %2, 月: %3, 日: %4, のんだか: %5\"\n  },\n  \"CUSTOM_MEDLOG_今日に書きこむ\": {\n    \"en\": \" %1 今日に書きこむ, のんだか: %2\"\n  },\n  \"CUSTOM_MEDLOG_消す\": {\n    \"en\": \" %1 消す, 年: %2, 月: %3, 日: %4\"\n  },\n  \"CUSTOM_MEDLOG_読みだす\": {\n    \"en\": \" %1 読みだす, 年: %2, 月: %3, 日: %4\"\n  },\n  \"CUSTOM_MEDLOG_一か月分読みだす\": {\n    \"en\": \" %1 一か月分読みだす, 年: %2, 月: %3\"\n  },\n  \"CUSTOM_MEDLOG_数える\": {\n    \"en\": \" %1 数える, 年: %2, 月: %3, のんだか: %4\"\n  },\n  \"CUSTOM_MEDLOG_まるばつにする\": {\n    \"en\": \" %1 まるばつにする, のんだか: %2\"\n  }\n};\n\nconst initType = 'custom_medlog_init';\nBlockly.BlockRegExpList['custom_medlog'] = {\n  regexp: new RegExp(/^custom_medlog_/),\n  code: \"from MedLog import MedLog\",\n  initBlockType: initType,\n  categoryId: 'custom_medlog',\n}\nBlockly.utils.registerLanguages(CUSTOM_MEDLOG_LANGUAGES)\n\nBlockly.Msg.CUSTOM_MEDLOG_HUE = '#0fb1d2'\nBlockly.Msg.CUSTOM_MEDLOG = 'MedLog'\n\nBlockly.utils.getcustom_medlogOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['medlog_0', 'medlog_0']\n  ];\n  return options;\n}\n\n\nBlockly.Blocks[\"custom_medlog_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_medlogOptions },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'medlog_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'フォルダ'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var フォルダ = Blockly.Python.valueToCode(block, 'フォルダ', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = MedLog(${フォルダ})\\n`\n}\n\nBlockly.Blocks[\"custom_medlog__path\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG__PATH,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'year'\n        }, {\n          'type': 'input_value',\n          'name': 'month'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog__path\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var year = Blockly.Python.valueToCode(block, 'year', Blockly.Python.ORDER_FUNCTION_CALL);\n  var month = Blockly.Python.valueToCode(block, 'month', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}._path(${year}, ${month})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_medlog__load\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG__LOAD,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'year'\n        }, {\n          'type': 'input_value',\n          'name': 'month'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog__load\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var year = Blockly.Python.valueToCode(block, 'year', Blockly.Python.ORDER_FUNCTION_CALL);\n  var month = Blockly.Python.valueToCode(block, 'month', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}._load(${year}, ${month})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_medlog__save\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG__SAVE,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'year'\n        }, {\n          'type': 'input_value',\n          'name': 'month'\n        }, {\n          'type': 'input_value',\n          'name': 'data'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog__save\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var year = Blockly.Python.valueToCode(block, 'year', Blockly.Python.ORDER_FUNCTION_CALL);\n  var month = Blockly.Python.valueToCode(block, 'month', Blockly.Python.ORDER_FUNCTION_CALL);\n  var data = Blockly.Python.valueToCode(block, 'data', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}._save(${year}, ${month}, ${data})\\n`\n}\n\nBlockly.Blocks[\"custom_medlog__days_in_month\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG__DAYS_IN_MONTH,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'year'\n        }, {\n          'type': 'input_value',\n          'name': 'month'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog__days_in_month\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var year = Blockly.Python.valueToCode(block, 'year', Blockly.Python.ORDER_FUNCTION_CALL);\n  var month = Blockly.Python.valueToCode(block, 'month', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}._days_in_month(${year}, ${month})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_medlog_書きこむ\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_書きこむ,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': '年'\n        }, {\n          'type': 'input_value',\n          'name': '月'\n        }, {\n          'type': 'input_value',\n          'name': '日'\n        }, {\n          'type': 'input_value',\n          'name': 'のんだか'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_書きこむ\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var 年 = Blockly.Python.valueToCode(block, '年', Blockly.Python.ORDER_FUNCTION_CALL);\n  var 月 = Blockly.Python.valueToCode(block, '月', Blockly.Python.ORDER_FUNCTION_CALL);\n  var 日 = Blockly.Python.valueToCode(block, '日', Blockly.Python.ORDER_FUNCTION_CALL);\n  var のんだか = Blockly.Python.valueToCode(block, 'のんだか', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.書きこむ(${年}, ${月}, ${日}, ${のんだか})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_medlog_今日に書きこむ\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_今日に書きこむ,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'のんだか'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_今日に書きこむ\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var のんだか = Blockly.Python.valueToCode(block, 'のんだか', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.今日に書きこむ(${のんだか})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_medlog_消す\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_消す,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': '年'\n        }, {\n          'type': 'input_value',\n          'name': '月'\n        }, {\n          'type': 'input_value',\n          'name': '日'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_消す\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var 年 = Blockly.Python.valueToCode(block, '年', Blockly.Python.ORDER_FUNCTION_CALL);\n  var 月 = Blockly.Python.valueToCode(block, '月', Blockly.Python.ORDER_FUNCTION_CALL);\n  var 日 = Blockly.Python.valueToCode(block, '日', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.消す(${年}, ${月}, ${日})\\n`\n}\n\nBlockly.Blocks[\"custom_medlog_読みだす\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_読みだす,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': '年'\n        }, {\n          'type': 'input_value',\n          'name': '月'\n        }, {\n          'type': 'input_value',\n          'name': '日'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_読みだす\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var 年 = Blockly.Python.valueToCode(block, '年', Blockly.Python.ORDER_FUNCTION_CALL);\n  var 月 = Blockly.Python.valueToCode(block, '月', Blockly.Python.ORDER_FUNCTION_CALL);\n  var 日 = Blockly.Python.valueToCode(block, '日', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.読みだす(${年}, ${月}, ${日})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_medlog_一か月分読みだす\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_一か月分読みだす,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': '年'\n        }, {\n          'type': 'input_value',\n          'name': '月'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_一か月分読みだす\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var 年 = Blockly.Python.valueToCode(block, '年', Blockly.Python.ORDER_FUNCTION_CALL);\n  var 月 = Blockly.Python.valueToCode(block, '月', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.一か月分読みだす(${年}, ${月})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_medlog_数える\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_数える,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': '年'\n        }, {\n          'type': 'input_value',\n          'name': '月'\n        }, {\n          'type': 'input_value',\n          'name': 'のんだか'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_数える\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var 年 = Blockly.Python.valueToCode(block, '年', Blockly.Python.ORDER_FUNCTION_CALL);\n  var 月 = Blockly.Python.valueToCode(block, '月', Blockly.Python.ORDER_FUNCTION_CALL);\n  var のんだか = Blockly.Python.valueToCode(block, 'のんだか', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.数える(${年}, ${月}, ${のんだか})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_medlog_まるばつにする\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_まるばつにする,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'のんだか'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_まるばつにする\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var のんだか = Blockly.Python.valueToCode(block, 'のんだか', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.まるばつにする(${のんだか})`, Blockly.Python.ORDER_NONE]\n}","toolbox":"\n<category name=\"MedLog\" colour=\"#0fb1d2\" hidden=\"true\" toolboxitemid=\"custom_medlog\">\n<title text=\"MedLog\" docsLink=\"\"></title>\n<block type=\"custom_medlog_init\">\n  <value name=\"フォルダ\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\">/flash/medlog</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_medlog_書きこむ\">\n  <value name=\"年\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"月\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"日\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"のんだか\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\"/>\n    </shadow>\n  </value>\n</block><block type=\"custom_medlog_今日に書きこむ\">\n  <value name=\"のんだか\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\"/>\n    </shadow>\n  </value>\n</block><block type=\"custom_medlog_消す\">\n  <value name=\"年\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"月\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"日\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_medlog_読みだす\">\n  <value name=\"年\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"月\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"日\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_medlog_一か月分読みだす\">\n  <value name=\"年\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"月\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_medlog_数える\">\n  <value name=\"年\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"月\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"のんだか\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\"/>\n    </shadow>\n  </value>\n</block><block type=\"custom_medlog_まるばつにする\">\n  <value name=\"のんだか\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\"/>\n    </shadow>\n  </value>\n</block>\n</category>\n","toolboxitemid":"custom_medlog","block_type":["custom_medlog___init__","custom_medlog__path","custom_medlog__load","custom_medlog__save","custom_medlog__days_in_month","custom_medlog_書きこむ","custom_medlog_今日に書きこむ","custom_medlog_消す","custom_medlog_読みだす","custom_medlog_一か月分読みだす","custom_medlog_数える","custom_medlog_まるばつにする"]},"data":{"name":"MedLog","note":{},"details":{"color":"#0fb1d2","link":"","image":"","category":"Custom"},"header":{"file":"","time":"","author":"","email":"","license":""},"assignments":[],"example":"","source_internal":"","source_external":"import os\nimport json\nimport time","members":[{"name":"__init__","note":{},"label":{"en":"%1 init, フォルダ: %2"},"params":[{"name":"フォルダ","type":"str","default":"/flash/medlog","note":{},"field":""}],"return":"","source":"        self._folder = フォルダ\n        self._statuses = (\"taken\", \"taken_notified\", \"notified\", \"missed\")\n        try:\n            os.mkdir(フォルダ)\n        except OSError:\n            pass  # すでにある","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"_path","note":{},"label":{"en":" %1 _path, year: %2, month: %3"},"params":[{"name":"year","type":null,"default":null,"note":{},"field":""},{"name":"month","type":null,"default":null,"note":{},"field":""}],"return":"","source":"        return \"{}/{:04d}-{:02d}.json\".format(self._folder, int(year), int(month))","ast_return":{"code":"'{}/{:04d}-{:02d}.json'.format(self._folder, int(year), int(month))","id":null},"doc_return":null},{"name":"_load","note":{},"label":{"en":" %1 _load, year: %2, month: %3"},"params":[{"name":"year","type":null,"default":null,"note":{},"field":""},{"name":"month","type":null,"default":null,"note":{},"field":""}],"return":"","source":"        try:\n            with open(self._path(year, month)) as f:\n                return json.load(f)\n        except (OSError, ValueError):\n            return {}","ast_return":{"code":"json.load(f)","id":null},"doc_return":null},{"name":"_save","note":{},"label":{"en":" %1 _save, year: %2, month: %3, data: %4"},"params":[{"name":"year","type":null,"default":null,"note":{},"field":""},{"name":"month","type":null,"default":null,"note":{},"field":""},{"name":"data","type":null,"default":null,"note":{},"field":""}],"return":"","source":"        path = self._path(year, month)\n        tmp = path + \".tmp\"\n        with open(tmp, \"w\") as f:\n            json.dump(data, f)\n        try:\n            os.remove(path)\n        except OSError:\n            pass\n        os.rename(tmp, path)","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"_days_in_month","note":{},"label":{"en":" %1 _days_in_month, year: %2, month: %3"},"params":[{"name":"year","type":null,"default":null,"note":{},"field":""},{"name":"month","type":null,"default":null,"note":{},"field":""}],"return":"","source":"        year, month = int(year), int(month)\n        if month == 2:\n            leap = (year % 4 == 0 and year % 100 != 0) or year % 400 == 0\n            return 29 if leap else 28\n        return 30 if month in (4, 6, 9, 11) else 31","ast_return":{"code":"30 if month in (4, 6, 9, 11) else 31","id":null},"doc_return":null},{"name":"書きこむ","note":{},"label":{"en":" %1 書きこむ, 年: %2, 月: %3, 日: %4, のんだか: %5"},"params":[{"name":"年","type":"int","default":"0","note":{},"field":""},{"name":"月","type":"int","default":"0","note":{},"field":""},{"name":"日","type":"int","default":"0","note":{},"field":""},{"name":"のんだか","type":"str","default":"","note":{},"field":""}],"return":"","source":"        # えらんだ日に書きこむ。うまくいったら True\n        if のんだか not in self._statuses:\n            return False\n        if not 1 <= int(日) <= self._days_in_month(年, 月):\n            return False\n        data = self._load(年, 月)\n        data[str(int(日))] = のんだか\n        self._save(年, 月, data)\n        return True","ast_return":{"code":"True","id":"bool"},"doc_return":null},{"name":"今日に書きこむ","note":{},"label":{"en":" %1 今日に書きこむ, のんだか: %2"},"params":[{"name":"のんだか","type":"str","default":"","note":{},"field":""}],"return":"","source":"        # 今日の日付で書きこむ（時計を合わせておくこと）\n        t = time.localtime()\n        return self.書きこむ(t[0], t[1], t[2], のんだか)","ast_return":{"code":"self.書きこむ(t[0], t[1], t[2], のんだか)","id":"bool"},"doc_return":null},{"name":"消す","note":{},"label":{"en":" %1 消す, 年: %2, 月: %3, 日: %4"},"params":[{"name":"年","type":"int","default":"0","note":{},"field":""},{"name":"月","type":"int","default":"0","note":{},"field":""},{"name":"日","type":"int","default":"0","note":{},"field":""}],"return":"","source":"        # えらんだ日に書いたものを消す\n        data = self._load(年, 月)\n        if str(int(日)) in data:\n            del data[str(int(日))]\n            self._save(年, 月, data)","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"読みだす","note":{},"label":{"en":" %1 読みだす, 年: %2, 月: %3, 日: %4"},"params":[{"name":"年","type":"int","default":"0","note":{},"field":""},{"name":"月","type":"int","default":"0","note":{},"field":""},{"name":"日","type":"int","default":"0","note":{},"field":""}],"return":"","source":"        # えらんだ日の「のんだか」。まだ書いていなければ空っぽ\n        return self._load(年, 月).get(str(int(日)), \"\")","ast_return":{"code":"self._load(年, 月).get(str(int(日)), '')","id":"str"},"doc_return":null},{"name":"一か月分読みだす","note":{},"label":{"en":" %1 一か月分読みだす, 年: %2, 月: %3"},"params":[{"name":"年","type":"int","default":"0","note":{},"field":""},{"name":"月","type":"int","default":"0","note":{},"field":""}],"return":"","source":"        # 1日から月の終わりまでを、じゅんばんにならべたリスト\n        # リストの1番目が1日。まだ書いていない日は空っぽ\n        data = self._load(年, 月)\n        return [data.get(str(d), \"\") for d in range(1, self._days_in_month(年, 月) + 1)]","ast_return":{"code":"[data.get(str(d), '') for d in range(1, self._days_in_month(年, 月) + 1)]","id":"list"},"doc_return":null},{"name":"数える","note":{},"label":{"en":" %1 数える, 年: %2, 月: %3, のんだか: %4"},"params":[{"name":"年","type":"int","default":"0","note":{},"field":""},{"name":"月","type":"int","default":"0","note":{},"field":""},{"name":"のんだか","type":"str","default":"","note":{},"field":""}],"return":"","source":"        # その月に、同じ「のんだか」の日が何日あるか\n        return sum(1 for v in self._load(年, 月).values() if v == のんだか)","ast_return":{"code":"sum((1 for v in self._load(年, 月).values() if v == のんだか))","id":"int"},"doc_return":null},{"name":"まるばつにする","note":{},"label":{"en":" %1 まるばつにする, のんだか: %2"},"params":[{"name":"のんだか","type":"str","default":"","note":{},"field":""}],"return":"","source":"        # 画面に出すための ○ △ ! × に変える\n        marks = {\"taken\": \"○\", \"taken_notified\": \"△\", \"notified\": \"!\", \"missed\": \"×\"}\n        return marks.get(のんだか, \"-\")","ast_return":{"code":"marks.get(のんだか, '-')","id":"str"},"doc_return":null}],"python_file_name":"medlog"},"pyCode":"\n\"\"\"\nfile     MedLog\ntime     2026-10-14\nauthor   \nemail   \nlicense  \n\"\"\"\n\nimport os\nimport json\nimport time\n\nclass MedLog:\n    \"\"\"\n    note: ''\n    details:\n        color: '#0fb1d2'\n        link: ''\n        image: ''\n        category: Custom\n    example: ''\n    \"\"\"\n\n\n\n\n    def __init__(self, フォルダ: str = '/flash/medlog'):\n        \"\"\"\n        label:\n            en: '%1 init, フォルダ: %2'\n        params:\n            フォルダ:\n                name: フォルダ\n                type: str\n                default: /flash/medlog\n        \"\"\"\n        self._folder = フォルダ\n        self._statuses = (\"taken\", \"taken_notified\", \"notified\", \"missed\")\n        try:\n            os.mkdir(フォルダ)\n        except OSError:\n            pass  # すでにある\n\n    def _path(self, year, month):\n        \"\"\"\n        label:\n            en: ' %1 _path, year: %2, month: %3'\n        params:\n            year:\n                name: year\n            month:\n                name: month\n        \"\"\"\n        return \"{}/{:04d}-{:02d}.json\".format(self._folder, int(year), int(month))\n\n    def _load(self, year, month):\n        \"\"\"\n        label:\n            en: ' %1 _load, year: %2, month: %3'\n        params:\n            year:\n                name: year\n            month:\n                name: month\n        \"\"\"\n        try:\n            with open(self._path(year, month)) as f:\n                return json.load(f)\n        except (OSError, ValueError):\n            return {}\n\n    def _save(self, year, month, data):\n        \"\"\"\n        label:\n            en: ' %1 _save, year: %2, month: %3, data: %4'\n        params:\n            year:\n                name: year\n            month:\n                name: month\n            data:\n                name: data\n        \"\"\"\n        path = self._path(year, month)\n        tmp = path + \".tmp\"\n        with open(tmp, \"w\") as f:\n            json.dump(data, f)\n        try:\n            os.remove(path)\n        except OSError:\n            pass\n        os.rename(tmp, path)\n\n    def _days_in_month(self, year, month):\n        \"\"\"\n        label:\n            en: ' %1 _days_in_month, year: %2, month: %3'\n        params:\n            year:\n                name: year\n            month:\n                name: month\n        \"\"\"\n        year, month = int(year), int(month)\n        if month == 2:\n            leap = (year % 4 == 0 and year % 100 != 0) or year % 400 == 0\n            return 29 if leap else 28\n        return 30 if month in (4, 6, 9, 11) else 31\n\n    def 書きこむ(self, 年: int = 0, 月: int = 0, 日: int = 0, のんだか: str) -> bool:\n        \"\"\"\n        label:\n            en: ' %1 書きこむ, 年: %2, 月: %3, 日: %4, のんだか: %5'\n        params:\n            年:\n                name: 年\n                type: int\n                default: '0'\n            月:\n                name: 月\n                type: int\n                default: '0'\n            日:\n                name: 日\n                type: int\n                default: '0'\n            のんだか:\n                name: のんだか\n                type: str\n        \"\"\"\n        # えらんだ日に書きこむ。うまくいったら True\n        if のんだか not in self._statuses:\n            return False\n        if not 1 <= int(日) <= self._days_in_month(年, 月):\n            return False\n        data = self._load(年, 月)\n        data[str(int(日))] = のんだか\n        self._save(年, 月, data)\n        return True\n\n    def 今日に書きこむ(self, のんだか: str) -> bool:\n        \"\"\"\n        label:\n            en: ' %1 今日に書きこむ, のんだか: %2'\n        params:\n            のんだか:\n                name: のんだか\n                type: str\n        \"\"\"\n        # 今日の日付で書きこむ（時計を合わせておくこと）\n        t = time.localtime()\n        return self.書きこむ(t[0], t[1], t[2], のんだか)\n\n    def 消す(self, 年: int = 0, 月: int = 0, 日: int = 0):\n        \"\"\"\n        label:\n            en: ' %1 消す, 年: %2, 月: %3, 日: %4'\n        params:\n            年:\n                name: 年\n                type: int\n                default: '0'\n            月:\n                name: 月\n                type: int\n                default: '0'\n            日:\n                name: 日\n                type: int\n                default: '0'\n        \"\"\"\n        # えらんだ日に書いたものを消す\n        data = self._load(年, 月)\n        if str(int(日)) in data:\n            del data[str(int(日))]\n            self._save(年, 月, data)\n\n    def 読みだす(self, 年: int = 0, 月: int = 0, 日: int = 0) -> str:\n        \"\"\"\n        label:\n            en: ' %1 読みだす, 年: %2, 月: %3, 日: %4'\n        params:\n            年:\n                name: 年\n                type: int\n                default: '0'\n            月:\n                name: 月\n                type: int\n                default: '0'\n            日:\n                name: 日\n                type: int\n                default: '0'\n        \"\"\"\n        # えらんだ日の「のんだか」。まだ書いていなければ空っぽ\n        return self._load(年, 月).get(str(int(日)), \"\")\n\n    def 一か月分読みだす(self, 年: int = 0, 月: int = 0) -> list:\n        \"\"\"\n        label:\n            en: ' %1 一か月分読みだす, 年: %2, 月: %3'\n        params:\n            年:\n                name: 年\n                type: int\n                default: '0'\n            月:\n                name: 月\n                type: int\n                default: '0'\n        \"\"\"\n        # 1日から月の終わりまでを、じゅんばんにならべたリスト\n        # リストの1番目が1日。まだ書いていない日は空っぽ\n        data = self._load(年, 月)\n        return [data.get(str(d), \"\") for d in range(1, self._days_in_month(年, 月) + 1)]\n\n    def 数える(self, 年: int = 0, 月: int = 0, のんだか: str) -> int:\n        \"\"\"\n        label:\n            en: ' %1 数える, 年: %2, 月: %3, のんだか: %4'\n        params:\n            年:\n                name: 年\n                type: int\n                default: '0'\n            月:\n                name: 月\n                type: int\n                default: '0'\n            のんだか:\n                name: のんだか\n                type: str\n        \"\"\"\n        # その月に、同じ「のんだか」の日が何日あるか\n        return sum(1 for v in self._load(年, 月).values() if v == のんだか)\n\n    def まるばつにする(self, のんだか: str) -> str:\n        \"\"\"\n        label:\n            en: ' %1 まるばつにする, のんだか: %2'\n        params:\n            のんだか:\n                name: のんだか\n                type: str\n        \"\"\"\n        # 画面に出すための ○ △ ! × に変える\n        marks = {\"taken\": \"○\", \"taken_notified\": \"△\", \"notified\": \"!\", \"missed\": \"×\"}\n        return marks.get(のんだか, \"-\")\n\n\n","version":"alpha2"}