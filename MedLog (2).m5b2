{"category":"MedLog","color":"#0fb1d2","uiflow2":{"jscode":"const CUSTOM_MEDLOG_LANGUAGES = {\n  \"CUSTOM_MEDLOG_INIT\": {\n    \"en\": \"%1 init, folder: %2\"\n  },\n  \"CUSTOM_MEDLOG__PATH\": {\n    \"en\": \" %1 _path, year: %2, month: %3\"\n  },\n  \"CUSTOM_MEDLOG__LOAD\": {\n    \"en\": \" %1 _load, year: %2, month: %3\"\n  },\n  \"CUSTOM_MEDLOG__SAVE\": {\n    \"en\": \" %1 _save, year: %2, month: %3, data: %4\"\n  },\n  \"CUSTOM_MEDLOG__DAYS_IN_MONTH\": {\n    \"en\": \" %1 _days_in_month, year: %2, month: %3\"\n  },\n  \"CUSTOM_MEDLOG_REGISTER\": {\n    \"en\": \" %1 register, year: %2, month: %3, day: %4, status: %5\"\n  },\n  \"CUSTOM_MEDLOG_REGISTER_TODAY\": {\n    \"en\": \" %1 register_today, status: %2\"\n  },\n  \"CUSTOM_MEDLOG_CLEAR_DAY\": {\n    \"en\": \" %1 clear_day, year: %2, month: %3, day: %4\"\n  },\n  \"CUSTOM_MEDLOG_CLEAR_ALL\": {\n    \"en\": \" %1 clear_all\"\n  },\n  \"CUSTOM_MEDLOG_GET_DAY\": {\n    \"en\": \" %1 get_day, year: %2, month: %3, day: %4\"\n  },\n  \"CUSTOM_MEDLOG_GET_MONTH\": {\n    \"en\": \" %1 get_month, year: %2, month: %3\"\n  },\n  \"CUSTOM_MEDLOG_COUNT\": {\n    \"en\": \" %1 count, year: %2, month: %3, status: %4\"\n  },\n  \"CUSTOM_MEDLOG_TO_MARK\": {\n    \"en\": \" %1 to_mark, status: %2\"\n  },\n  \"CUSTOM_MEDLOG_GET_ALL\": {\n    \"en\": \" %1 get_all\"\n  }\n};\n\nconst initType = 'custom_medlog_init';\nBlockly.BlockRegExpList['custom_medlog'] = {\n  regexp: new RegExp(/^custom_medlog_/),\n  code: \"from MedLog import MedLog\",\n  initBlockType: initType,\n  categoryId: 'custom_medlog',\n}\nBlockly.utils.registerLanguages(CUSTOM_MEDLOG_LANGUAGES)\n\nBlockly.Msg.CUSTOM_MEDLOG_HUE = '#0fb1d2'\nBlockly.Msg.CUSTOM_MEDLOG = 'MedLog'\n\nBlockly.utils.getcustom_medlogOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['medlog_0', 'medlog_0']\n  ];\n  return options;\n}\n\n\nBlockly.Blocks[\"custom_medlog_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_medlogOptions },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'medlog_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'folder'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var folder = Blockly.Python.valueToCode(block, 'folder', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = MedLog(${folder})\\n`\n}\n\nBlockly.Blocks[\"custom_medlog__path\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG__PATH,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'year'\n        }, {\n          'type': 'input_value',\n          'name': 'month'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog__path\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var year = Blockly.Python.valueToCode(block, 'year', Blockly.Python.ORDER_FUNCTION_CALL);\n  var month = Blockly.Python.valueToCode(block, 'month', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}._path(${year}, ${month})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_medlog__load\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG__LOAD,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'year'\n        }, {\n          'type': 'input_value',\n          'name': 'month'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog__load\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var year = Blockly.Python.valueToCode(block, 'year', Blockly.Python.ORDER_FUNCTION_CALL);\n  var month = Blockly.Python.valueToCode(block, 'month', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}._load(${year}, ${month})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_medlog__save\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG__SAVE,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'year'\n        }, {\n          'type': 'input_value',\n          'name': 'month'\n        }, {\n          'type': 'input_value',\n          'name': 'data'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog__save\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var year = Blockly.Python.valueToCode(block, 'year', Blockly.Python.ORDER_FUNCTION_CALL);\n  var month = Blockly.Python.valueToCode(block, 'month', Blockly.Python.ORDER_FUNCTION_CALL);\n  var data = Blockly.Python.valueToCode(block, 'data', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}._save(${year}, ${month}, ${data})\\n`\n}\n\nBlockly.Blocks[\"custom_medlog__days_in_month\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG__DAYS_IN_MONTH,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'year'\n        }, {\n          'type': 'input_value',\n          'name': 'month'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog__days_in_month\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var year = Blockly.Python.valueToCode(block, 'year', Blockly.Python.ORDER_FUNCTION_CALL);\n  var month = Blockly.Python.valueToCode(block, 'month', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}._days_in_month(${year}, ${month})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_medlog_register\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_REGISTER,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'year'\n        }, {\n          'type': 'input_value',\n          'name': 'month'\n        }, {\n          'type': 'input_value',\n          'name': 'day'\n        }, {\n          'type': 'input_value',\n          'name': 'status'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_register\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var year = Blockly.Python.valueToCode(block, 'year', Blockly.Python.ORDER_FUNCTION_CALL);\n  var month = Blockly.Python.valueToCode(block, 'month', Blockly.Python.ORDER_FUNCTION_CALL);\n  var day = Blockly.Python.valueToCode(block, 'day', Blockly.Python.ORDER_FUNCTION_CALL);\n  var status = Blockly.Python.valueToCode(block, 'status', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.register(${year}, ${month}, ${day}, ${status})\\n`\n}\n\nBlockly.Blocks[\"custom_medlog_register_today\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_REGISTER_TODAY,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'status'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_register_today\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var status = Blockly.Python.valueToCode(block, 'status', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.register_today(${status})\\n`\n}\n\nBlockly.Blocks[\"custom_medlog_clear_day\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_CLEAR_DAY,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'year'\n        }, {\n          'type': 'input_value',\n          'name': 'month'\n        }, {\n          'type': 'input_value',\n          'name': 'day'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_clear_day\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var year = Blockly.Python.valueToCode(block, 'year', Blockly.Python.ORDER_FUNCTION_CALL);\n  var month = Blockly.Python.valueToCode(block, 'month', Blockly.Python.ORDER_FUNCTION_CALL);\n  var day = Blockly.Python.valueToCode(block, 'day', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.clear_day(${year}, ${month}, ${day})\\n`\n}\n\nBlockly.Blocks[\"custom_medlog_clear_all\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_CLEAR_ALL,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_clear_all\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.clear_all()\\n`\n}\n\nBlockly.Blocks[\"custom_medlog_get_day\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_GET_DAY,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'year'\n        }, {\n          'type': 'input_value',\n          'name': 'month'\n        }, {\n          'type': 'input_value',\n          'name': 'day'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_get_day\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var year = Blockly.Python.valueToCode(block, 'year', Blockly.Python.ORDER_FUNCTION_CALL);\n  var month = Blockly.Python.valueToCode(block, 'month', Blockly.Python.ORDER_FUNCTION_CALL);\n  var day = Blockly.Python.valueToCode(block, 'day', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.get_day(${year}, ${month}, ${day})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_medlog_get_month\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_GET_MONTH,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'year'\n        }, {\n          'type': 'input_value',\n          'name': 'month'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_get_month\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var year = Blockly.Python.valueToCode(block, 'year', Blockly.Python.ORDER_FUNCTION_CALL);\n  var month = Blockly.Python.valueToCode(block, 'month', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.get_month(${year}, ${month})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_medlog_count\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_COUNT,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'year'\n        }, {\n          'type': 'input_value',\n          'name': 'month'\n        }, {\n          'type': 'input_value',\n          'name': 'status'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_count\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var year = Blockly.Python.valueToCode(block, 'year', Blockly.Python.ORDER_FUNCTION_CALL);\n  var month = Blockly.Python.valueToCode(block, 'month', Blockly.Python.ORDER_FUNCTION_CALL);\n  var status = Blockly.Python.valueToCode(block, 'status', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.count(${year}, ${month}, ${status})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_medlog_to_mark\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_TO_MARK,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'status'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_to_mark\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var status = Blockly.Python.valueToCode(block, 'status', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.to_mark(${status})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_medlog_get_all\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_GET_ALL,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_get_all\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.get_all()`, Blockly.Python.ORDER_NONE]\n}","toolbox":"\n<category name=\"MedLog\" colour=\"#0fb1d2\" hidden=\"true\" toolboxitemid=\"custom_medlog\">\n<title text=\"MedLog\" docsLink=\"\"></title>\n<block type=\"custom_medlog_init\">\n  <value name=\"folder\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\">/flash/medlog</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_medlog_register\">\n  <value name=\"year\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"month\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"day\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"status\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\"/>\n    </shadow>\n  </value>\n</block><block type=\"custom_medlog_register_today\">\n  <value name=\"status\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\"/>\n    </shadow>\n  </value>\n</block><block type=\"custom_medlog_clear_day\">\n  <value name=\"year\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"month\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"day\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_medlog_clear_all\"/><block type=\"custom_medlog_get_day\">\n  <value name=\"year\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"month\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"day\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_medlog_get_month\">\n  <value name=\"year\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"month\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_medlog_count\">\n  <value name=\"year\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"month\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"status\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\"/>\n    </shadow>\n  </value>\n</block><block type=\"custom_medlog_to_mark\">\n  <value name=\"status\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\"/>\n    </shadow>\n  </value>\n</block><block type=\"custom_medlog_get_all\"/>\n</category>\n","toolboxitemid":"custom_medlog","block_type":["custom_medlog___init__","custom_medlog__path","custom_medlog__load","custom_medlog__save","custom_medlog__days_in_month","custom_medlog_register","custom_medlog_register_today","custom_medlog_clear_day","custom_medlog_clear_all","custom_medlog_get_day","custom_medlog_get_month","custom_medlog_count","custom_medlog_to_mark","custom_medlog_get_all"]},"data":{"name":"MedLog","note":{},"details":{"color":"#0fb1d2","link":"","image":"","category":"Custom"},"header":{"file":"","time":"","author":"","email":"","license":""},"assignments":[],"example":"","source_internal":"","source_external":"import os\nimport json\nimport time","members":[{"name":"__init__","note":{},"label":{"en":"%1 init, folder: %2"},"params":[{"name":"folder","type":"str","default":"/flash/medlog","note":{},"field":""}],"return":"","source":"        self._folder = folder\n        self._statuses = (\"taken\", \"taken_notified\", \"notified\", \"missed\")\n        try:\n            os.mkdir(folder)\n        except OSError:\n            pass","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"_path","note":{},"label":{"en":" %1 _path, year: %2, month: %3"},"params":[{"name":"year","type":null,"default":null,"note":{},"field":""},{"name":"month","type":null,"default":null,"note":{},"field":""}],"return":"","source":"        return \"{}/{:04d}-{:02d}.json\".format(self._folder, int(year), int(month))","ast_return":{"code":"'{}/{:04d}-{:02d}.json'.format(self._folder, int(year), int(month))","id":null},"doc_return":null},{"name":"_load","note":{},"label":{"en":" %1 _load, year: %2, month: %3"},"params":[{"name":"year","type":null,"default":null,"note":{},"field":""},{"name":"month","type":null,"default":null,"note":{},"field":""}],"return":"","source":"        try:\n            with open(self._path(year, month)) as f:\n                return json.load(f)\n        except (OSError, ValueError):\n            return {}","ast_return":{"code":"json.load(f)","id":null},"doc_return":null},{"name":"_save","note":{},"label":{"en":" %1 _save, year: %2, month: %3, data: %4"},"params":[{"name":"year","type":null,"default":null,"note":{},"field":""},{"name":"month","type":null,"default":null,"note":{},"field":""},{"name":"data","type":null,"default":null,"note":{},"field":""}],"return":"","source":"        path = self._path(year, month)\n        tmp = path + \".tmp\"\n        with open(tmp, \"w\") as f:\n            json.dump(data, f)\n        try:\n            os.remove(path)\n        except OSError:\n            pass\n        os.rename(tmp, path)","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"_days_in_month","note":{},"label":{"en":" %1 _days_in_month, year: %2, month: %3"},"params":[{"name":"year","type":null,"default":null,"note":{},"field":""},{"name":"month","type":null,"default":null,"note":{},"field":""}],"return":"","source":"        year, month = int(year), int(month)\n        if month == 2:\n            leap = (year % 4 == 0 and year % 100 != 0) or year % 400 == 0\n            return 29 if leap else 28\n        return 30 if month in (4, 6, 9, 11) else 31","ast_return":{"code":"30 if month in (4, 6, 9, 11) else 31","id":null},"doc_return":null},{"name":"register","note":{},"label":{"en":" %1 register, year: %2, month: %3, day: %4, status: %5"},"params":[{"name":"year","type":"int","default":"0","note":{},"field":""},{"name":"month","type":"int","default":"0","note":{},"field":""},{"name":"day","type":"int","default":"0","note":{},"field":""},{"name":"status","type":"str","default":"","note":{},"field":""}],"return":"","source":"        # Save the status for the given day. Invalid input is ignored.\n        if status not in self._statuses:\n            print(\"MedLog: unknown status\", status)\n            return\n        if not 1 <= int(day) <= self._days_in_month(year, month):\n            print(\"MedLog: invalid date\", year, month, day)\n            return\n        data = self._load(year, month)\n        data[str(int(day))] = status\n        self._save(year, month, data)","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"register_today","note":{},"label":{"en":" %1 register_today, status: %2"},"params":[{"name":"status","type":"str","default":"","note":{},"field":""}],"return":"","source":"        # Save the status for today (set the clock with NTP first).\n        t = time.localtime()\n        self.register(t[0], t[1], t[2], status)","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"clear_day","note":{},"label":{"en":" %1 clear_day, year: %2, month: %3, day: %4"},"params":[{"name":"year","type":"int","default":"0","note":{},"field":""},{"name":"month","type":"int","default":"0","note":{},"field":""},{"name":"day","type":"int","default":"0","note":{},"field":""}],"return":"","source":"        # Delete the record for the given day.\n        data = self._load(year, month)\n        if str(int(day)) in data:\n            del data[str(int(day))]\n            self._save(year, month, data)","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"clear_all","note":{},"label":{"en":" %1 clear_all"},"params":[],"return":"","source":"        # Delete every record of every month (for testing; cannot be undone).\n        for name in os.listdir(self._folder):\n            if name.endswith(\".json\") or name.endswith(\".tmp\"):\n                try:\n                    os.remove(self._folder + \"/\" + name)\n                except OSError:\n                    pass","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"get_day","note":{},"label":{"en":" %1 get_day, year: %2, month: %3, day: %4"},"params":[{"name":"year","type":"int","default":"0","note":{},"field":""},{"name":"month","type":"int","default":"0","note":{},"field":""},{"name":"day","type":"int","default":"0","note":{},"field":""}],"return":"","source":"        # Status of the given day. Empty string if no record.\n        return self._load(year, month).get(str(int(day)), \"\")","ast_return":{"code":"self._load(year, month).get(str(int(day)), '')","id":"str"},"doc_return":null},{"name":"get_month","note":{},"label":{"en":" %1 get_month, year: %2, month: %3"},"params":[{"name":"year","type":"int","default":"0","note":{},"field":""},{"name":"month","type":"int","default":"0","note":{},"field":""}],"return":"","source":"        # Statuses from day 1 to the end of the month, in order.\n        # The first item is day 1. Days with no record are empty strings.\n        data = self._load(year, month)\n        return [data.get(str(d), \"\") for d in range(1, self._days_in_month(year, month) + 1)]","ast_return":{"code":"[data.get(str(d), '') for d in range(1, self._days_in_month(year, month) + 1)]","id":"list"},"doc_return":null},{"name":"count","note":{},"label":{"en":" %1 count, year: %2, month: %3, status: %4"},"params":[{"name":"year","type":"int","default":"0","note":{},"field":""},{"name":"month","type":"int","default":"0","note":{},"field":""},{"name":"status","type":"str","default":"","note":{},"field":""}],"return":"","source":"        # Number of days in the month that have the given status.\n        return sum(1 for v in self._load(year, month).values() if v == status)","ast_return":{"code":"sum((1 for v in self._load(year, month).values() if v == status))","id":"int"},"doc_return":null},{"name":"to_mark","note":{},"label":{"en":" %1 to_mark, status: %2"},"params":[{"name":"status","type":"str","default":"","note":{},"field":""}],"return":"","source":"        # Convert a status to a symbol for the screen.\n        marks = {\"taken\": \"○\", \"taken_notified\": \"△\", \"notified\": \"!\", \"missed\": \"×\"}\n        return marks.get(status, \"-\")","ast_return":{"code":"marks.get(status, '-')","id":"str"},"doc_return":null},{"name":"get_all","note":{},"label":{"en":" %1 get_all"},"params":[],"return":"","source":"        # Every record of every month (for testing).\n        # e.g. {\"2026-10\": {\"1\": \"taken\"}, \"2026-11\": {\"3\": \"missed\"}}\n        result = {}\n        for name in sorted(os.listdir(self._folder)):\n            if name.endswith(\".json\"):\n                try:\n                    with open(self._folder + \"/\" + name) as f:\n                        result[name[:-5]] = json.load(f)\n                except (OSError, ValueError):\n                    pass\n        return result","ast_return":{"code":"result","id":"dict"},"doc_return":null}],"python_file_name":"medlog"},"pyCode":"\n\"\"\"\nfile     MedLog\ntime     2026-10-14\nauthor   \nemail   \nlicense  \n\"\"\"\n\nimport os\nimport json\nimport time\n\nclass MedLog:\n    \"\"\"\n    note: ''\n    details:\n        color: '#0fb1d2'\n        link: ''\n        image: ''\n        category: Custom\n    example: ''\n    \"\"\"\n\n\n\n\n    def __init__(self, folder: str = '/flash/medlog'):\n        \"\"\"\n        label:\n            en: '%1 init, folder: %2'\n        params:\n            folder:\n                name: folder\n                type: str\n                default: /flash/medlog\n        \"\"\"\n        self._folder = folder\n        self._statuses = (\"taken\", \"taken_notified\", \"notified\", \"missed\")\n        try:\n            os.mkdir(folder)\n        except OSError:\n            pass\n\n    def _path(self, year, month):\n        \"\"\"\n        label:\n            en: ' %1 _path, year: %2, month: %3'\n        params:\n            year:\n                name: year\n            month:\n                name: month\n        \"\"\"\n        return \"{}/{:04d}-{:02d}.json\".format(self._folder, int(year), int(month))\n\n    def _load(self, year, month):\n        \"\"\"\n        label:\n            en: ' %1 _load, year: %2, month: %3'\n        params:\n            year:\n                name: year\n            month:\n                name: month\n        \"\"\"\n        try:\n            with open(self._path(year, month)) as f:\n                return json.load(f)\n        except (OSError, ValueError):\n            return {}\n\n    def _save(self, year, month, data):\n        \"\"\"\n        label:\n            en: ' %1 _save, year: %2, month: %3, data: %4'\n        params:\n            year:\n                name: year\n            month:\n                name: month\n            data:\n                name: data\n        \"\"\"\n        path = self._path(year, month)\n        tmp = path + \".tmp\"\n        with open(tmp, \"w\") as f:\n            json.dump(data, f)\n        try:\n            os.remove(path)\n        except OSError:\n            pass\n        os.rename(tmp, path)\n\n    def _days_in_month(self, year, month):\n        \"\"\"\n        label:\n            en: ' %1 _days_in_month, year: %2, month: %3'\n        params:\n            year:\n                name: year\n            month:\n                name: month\n        \"\"\"\n        year, month = int(year), int(month)\n        if month == 2:\n            leap = (year % 4 == 0 and year % 100 != 0) or year % 400 == 0\n            return 29 if leap else 28\n        return 30 if month in (4, 6, 9, 11) else 31\n\n    def register(self, year: int = 0, month: int = 0, day: int = 0, status: str):\n        \"\"\"\n        label:\n            en: ' %1 register, year: %2, month: %3, day: %4, status: %5'\n        params:\n            year:\n                name: year\n                type: int\n                default: '0'\n            month:\n                name: month\n                type: int\n                default: '0'\n            day:\n                name: day\n                type: int\n                default: '0'\n            status:\n                name: status\n                type: str\n        \"\"\"\n        # Save the status for the given day. Invalid input is ignored.\n        if status not in self._statuses:\n            print(\"MedLog: unknown status\", status)\n            return\n        if not 1 <= int(day) <= self._days_in_month(year, month):\n            print(\"MedLog: invalid date\", year, month, day)\n            return\n        data = self._load(year, month)\n        data[str(int(day))] = status\n        self._save(year, month, data)\n\n    def register_today(self, status: str):\n        \"\"\"\n        label:\n            en: ' %1 register_today, status: %2'\n        params:\n            status:\n                name: status\n                type: str\n        \"\"\"\n        # Save the status for today (set the clock with NTP first).\n        t = time.localtime()\n        self.register(t[0], t[1], t[2], status)\n\n    def clear_day(self, year: int = 0, month: int = 0, day: int = 0):\n        \"\"\"\n        label:\n            en: ' %1 clear_day, year: %2, month: %3, day: %4'\n        params:\n            year:\n                name: year\n                type: int\n                default: '0'\n            month:\n                name: month\n                type: int\n                default: '0'\n            day:\n                name: day\n                type: int\n                default: '0'\n        \"\"\"\n        # Delete the record for the given day.\n        data = self._load(year, month)\n        if str(int(day)) in data:\n            del data[str(int(day))]\n            self._save(year, month, data)\n\n    def clear_all(self):\n        \"\"\"\n        label:\n            en: ' %1 clear_all'\n        \"\"\"\n        # Delete every record of every month (for testing; cannot be undone).\n        for name in os.listdir(self._folder):\n            if name.endswith(\".json\") or name.endswith(\".tmp\"):\n                try:\n                    os.remove(self._folder + \"/\" + name)\n                except OSError:\n                    pass\n\n    def get_day(self, year: int = 0, month: int = 0, day: int = 0) -> str:\n        \"\"\"\n        label:\n            en: ' %1 get_day, year: %2, month: %3, day: %4'\n        params:\n            year:\n                name: year\n                type: int\n                default: '0'\n            month:\n                name: month\n                type: int\n                default: '0'\n            day:\n                name: day\n                type: int\n                default: '0'\n        \"\"\"\n        # Status of the given day. Empty string if no record.\n        return self._load(year, month).get(str(int(day)), \"\")\n\n    def get_month(self, year: int = 0, month: int = 0) -> list:\n        \"\"\"\n        label:\n            en: ' %1 get_month, year: %2, month: %3'\n        params:\n            year:\n                name: year\n                type: int\n                default: '0'\n            month:\n                name: month\n                type: int\n                default: '0'\n        \"\"\"\n        # Statuses from day 1 to the end of the month, in order.\n        # The first item is day 1. Days with no record are empty strings.\n        data = self._load(year, month)\n        return [data.get(str(d), \"\") for d in range(1, self._days_in_month(year, month) + 1)]\n\n    def count(self, year: int = 0, month: int = 0, status: str) -> int:\n        \"\"\"\n        label:\n            en: ' %1 count, year: %2, month: %3, status: %4'\n        params:\n            year:\n                name: year\n                type: int\n                default: '0'\n            month:\n                name: month\n                type: int\n                default: '0'\n            status:\n                name: status\n                type: str\n        \"\"\"\n        # Number of days in the month that have the given status.\n        return sum(1 for v in self._load(year, month).values() if v == status)\n\n    def to_mark(self, status: str) -> str:\n        \"\"\"\n        label:\n            en: ' %1 to_mark, status: %2'\n        params:\n            status:\n                name: status\n                type: str\n        \"\"\"\n        # Convert a status to a symbol for the screen.\n        marks = {\"taken\": \"○\", \"taken_notified\": \"△\", \"notified\": \"!\", \"missed\": \"×\"}\n        return marks.get(status, \"-\")\n\n    def get_all(self) -> dict:\n        \"\"\"\n        label:\n            en: ' %1 get_all'\n        \"\"\"\n        # Every record of every month (for testing).\n        # e.g. {\"2026-10\": {\"1\": \"taken\"}, \"2026-11\": {\"3\": \"missed\"}}\n        result = {}\n        for name in sorted(os.listdir(self._folder)):\n            if name.endswith(\".json\"):\n                try:\n                    with open(self._folder + \"/\" + name) as f:\n                        result[name[:-5]] = json.load(f)\n                except (OSError, ValueError):\n                    pass\n        return result\n\n\n","version":"alpha2"}